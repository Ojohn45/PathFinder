# Copy this file to .env, then fill in the settings you need.
# The app reads .env automatically when it starts.

# Required only when creating the first head-admin account.
ADMIN_FULLNAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional phone number for head-admin login.
ADMIN_PHONE=

# Set this when sending invitation links from a deployed site.
BASE_URL=

# Optional SMTP settings. Gmail needs an App Password; Brevo needs an SMTP key.
# You can also configure email from Admin > Email Settings after setup.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
